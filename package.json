{
  "name": "tandem-local",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:repo": "node scripts/check-repo.mjs",
    "skills:sync": "node scripts/skills-sync.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test web/src/*.test.ts && esbuild web/tests/health.test.tsx --bundle --platform=node --format=esm --packages=external --outfile=.tools/health-tests.mjs && node --test .tools/health-tests.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
